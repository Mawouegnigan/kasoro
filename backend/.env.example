# Copie ce fichier en .env et adapte les valeurs

APP_NAME=Kasoro API
DEBUG=true

# PostgreSQL (async, driver asyncpg)
DATABASE_URL=postgresql+asyncpg://kasoro:kasoro@db:5432/kasoro

# true = vrai pipeline (Groq STT + MT + MMS TTS local), false = stub (dev rapide)
USE_REAL_PIPELINE=true

# Nécessaire dès que USE_REAL_PIPELINE=true (utilisé par pipeline/pipeline.py)
GROQ_API_KEY=

# Utilisé par docker-compose pour initialiser Postgres
POSTGRES_USER=kasoro
POSTGRES_PASSWORD=kasoro
POSTGRES_DB=kasoro


# Stockage audio uploadé (local pour l'instant, S3/Cloudinary plus tard)
AUDIO_STORAGE_BACKEND=local
AUDIO_BASE_URL=http://localhost:8000/audio